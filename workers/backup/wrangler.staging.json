{
  "name": "run-backup-staging",
  "main": "index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "35 7 * * *"
    ]
  },
  "vars": {
    "BACKUP_ENV": "staging"
  },
  "d1_databases": [
    {
      "binding": "SOURCE",
      "database_name": "run-auth-staging",
      "database_id": "SOURCE_DATABASE_ID"
    },
    {
      "binding": "SCRATCH",
      "database_name": "restore-test-run-staging",
      "database_id": "SCRATCH_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "synthetos-db-backups"
    }
  ],
  "find_additional_modules": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.mjs"
      ]
    }
  ]
}
