// The run Worker (ROADMAP P0-04, RUN_PLAN §5.2, §6.3, SAFETY H45, H46).
//
// This file is CODEOWNED. Rules that must never change without the owner:
//   - workers_dev and preview_urls stay false in EVERY environment. Each
//     workers.dev, preview or version URL is a separate origin with its own
//     Web Serial grant (SAFETY H45). tools/gates/test/worker-config.test.ts fails
//     otherwise.
//   - The Worker runs first for EVERY path, on staging (P1-00) and in
//     production (OD-29, owner 2026-11-09): it is what grants Web Serial to
//     its own host's documents, `serial=(self)`, and only when RUN_ENV and the
//     host match and production has a validated session (src/headers.ts grantsSerial). Anything that ever bypassed it
//     would get apps/web/public/_headers (generated from src/headers.ts, the
//     fail-closed set): serial=(). Who may connect is the D1 sign-in gate's
//     decision (accounts admits the D37 allowlist only).
//   - account_id is the CURRENT Cloudflare account, which also holds the
//     synthetos.com zone (D39, which supersedes D34: Workers custom domains
//     need the zone in the same account). It is locked down:
//     CI-only deploys with a token scoped to the run and accounts Workers, a
//     hardware-key owner login, audit-log alerts on any change CI did not
//     make, and no local wrangler login used to deploy run (docs/ops/
//     account.md). The value below is a placeholder until the owner fills in
//     that account's id; the deploy jobs refuse to run while it is a
//     placeholder (tools/gates/src/deploy/preflight.ts).
//   - run is the only Worker configuration allowed to bind `accounts`
//     (D39: service bindings work inside one account). `pnpm ci-policy`
//     refuses any other wrangler configuration that does
//     (tools/gates/src/bindings/check.ts), and run may bind only accounts'
//     RunEntrypoint (tools/gates/src/deploy/wranglerConfig.ts).
//   - Deploys are always 100% (`wrangler deploy`), never gradual
//     (`wrangler versions deploy` with percentages is not used).
//
// CI deploys the attested artifact, not this directory's source:
//   wrangler deploy <artifact>/worker/index.mjs --no-bundle --assets <artifact>/site
// `wrangler dev` (local) bundles src/index.ts and serves ../../apps/web/dist.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "run",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // The artifact's Worker is several .mjs modules (tools/gates/src/build/
  // worker.ts). With --no-bundle, wrangler attaches them only with these two
  // settings. They do not affect `wrangler dev`, which bundles src/*.ts.
  "find_additional_modules": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs"] }],
  "account_id": "79866c4d48cb424b8cb3ac3b9955d46b",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "run.synthetos.com", "custom_domain": true }],
  "vars": { "RUN_ENV": "production" },
  // A1-06/A1-07: production has NO sign-in bindings yet, so sign-in is off there and production deploys as
  // before. The owner's go-live step adds them (docs/ops/go-live-staging.md §7): exactly
  //   "services": [{ "binding": "ACCOUNTS", "service": "accounts", "entrypoint": "RunEntrypoint" }],
  //   "d1_databases": [{ "binding": "RUN_AUTH", "database_name": "run-auth", "database_id": "<id>", "migrations_dir": "migrations" }],
  // The conditional RUN_AUTH migration step in deploy-production is already present.
  "env": {
    // staging.run.synthetos.com, behind Cloudflare Access (D31,
    // docs/ops/access.md). Deployed as the Worker `run-staging`.
    "staging": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "staging.run.synthetos.com", "custom_domain": true }],
      "vars": { "RUN_ENV": "staging" },
      // Sign-in (A1-06/A1-07): the one service binding run may hold is accounts' named RunEntrypoint (the
      // entrypoint pins the client in accounts' code; D39, tools/gates/src/bindings/check.ts). RUN_AUTH is run's
      // own D1 database for pending sign-ins and device rows (workers/run/migrations). Its id is a placeholder
      // until the owner creates the database; preflight strips both bindings while it is a placeholder. Two
      // Worker secrets are set by the owner, never in this file: RUN_STATE_KEY and RUN_RATE_KEY. Without all of
      // these, sign-in stays off and /auth/* is a 404.
      "services": [{ "binding": "ACCOUNTS", "service": "accounts-staging", "entrypoint": "RunEntrypoint" }, { "binding": "RUN_DATA", "service": "run-data-staging", "entrypoint": "AppEntrypoint" }],
      "d1_databases": [
        { "binding": "RUN_AUTH", "database_name": "run-auth-staging", "database_id": "0ab71cac-0c75-428c-a520-6293612078a3", "migrations_dir": "migrations" }
      ],
      // The top-level assets settings with run_worker_first for every path
      // (see the rule above). tools/gates/src/deploy/wranglerConfig.ts pins
      // both objects exactly.
      "assets": {
        "directory": "../../apps/web/dist",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": true
      }
    }
  }
}
