# account and the accounts binding, D39), the generated asset headers and the Trusted Types
# policies are part of the header contract (RUN_PLAN §6.4, T-S25).
/workers/run/wrangler.jsonc         @ril3y
/apps/web/public/_headers           @ril3y
/apps/web/src/security/             @ril3y

# --- ROADMAP P0-08 additions --------------------------------------------
# Who may stream: the capability probe, the classifier, the signed
# approved-builds manifest and the keys that verify it (SAFETY H44, H27,
# §8 item 28), and the firmware pins every protocol citation rests on (PIN-1).
/packages/protocol/src/probe.ts          @ril3y
/packages/protocol/src/approvedBuilds.ts @ril3y
/packages/protocol/src/releaseKeys.ts    @ril3y
/firmware/                               @ril3y
/vendor/firmware-pins.json               @ril3y
/packages/schema/boards.schema.json      @ril3y

# --- ROADMAP P0-09 additions --------------------------------------------
# What the app may read and write on a TinyG: the read allowlists (SAFETY §8
# lists packages/schema/allowlists/**; the code lives under src/), the
# get/set classification they are checked against, the forbidden writes, the
# edge-next overlay (ranges, risk classes, typed confirmations), the
# generated tables, validation and the write-plan gate.
/packages/schema/src/allowlists/**       @ril3y
/packages/schema/src/tables/**           @ril3y
/packages/schema/src/generated/**        @ril3y
/packages/schema/src/overlays/**         @ril3y
/packages/schema/src/forbiddenWrites.ts  @ril3y
/packages/schema/src/settingsSchema.ts   @ril3y
/packages/schema/src/validate.ts         @ril3y
/packages/schema/src/writePlan.ts        @ril3y

# --- ROADMAP P0-14 additions --------------------------------------------
# machine.worker owns the serial link (RUN_PLAN §5.1 rule 1, §5.4), and its
# transport seam decides how any build reaches a controller. The fake-serial
# replacement decides what the e2e suite tests in its place.
/apps/web/src/machine-worker/            @ril3y
/apps/web/src/channel/                   @ril3y
/workers/run/src/index.ts                @ril3y
/workers/run/src/routes.ts               @ril3y
/tools/e2e/fake-serial/                  @ril3y

# --- Report a problem (REPORT_A_PROBLEM §6) -------------------------------
# The fixed allowlist of report destinations. The bundle scan admits these
# exact URLs in JavaScript chunks, so a change here changes what it allows.
/apps/web/src/report/targets.ts          @ril3y

