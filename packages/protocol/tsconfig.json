{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Tests read fixture files with node:fs. Runtime source never uses Node
    // built-ins: dependency-cruiser's safety-path-no-node-core refuses it.
    // Runtime source uses only TextDecoder/TextEncoder, which browsers and
    // workers also provide.
    "types": ["node"]
  },
  "include": [
    "src",
    "test"
  ]
}
