{
  "name": "@synthetos/testkit",
  "version": "0.0.0",
  "private": true,
  "description": "DEV ONLY. Firmware models, MockSerial, fault plans, virtual clock and replay transport for tests. Never part of a production bundle.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "gen:status": "node scripts/gen-status.ts",
    "gen:sim-firmware": "node scripts/gen-sim-firmware.ts"
  },
  "devDependencies": {
    "@synthetos/flasher": "workspace:*",
    "@synthetos/protocol": "workspace:*"
  }
}
