exports[`sanitiser report messages > are pinned for every rule 1`] = `
{
  "tinyg-440 c22 last line": [
    {
      "line": 1,
      "message": "the last line turns the spindle or coolant on together with the program end, so the file ends with flood coolant on (M8); move the M3/M4/M7/M8 off that line",
      "rule": "end-state",
      "severity": "block",
    },
  ],
  "tinyg-440 codes": [
    {
      "line": 1,
      "message": "G59.1 is not supported in a job on this firmware (a dotted code is never sent as G59)",
      "rule": "unsupported-code",
      "severity": "block",
    },
    {
      "line": 2,
      "message": "G43 is not supported in a job on this firmware",
      "rule": "unsupported-code",
      "severity": "block",
    },
    {
      "line": 3,
      "message": "M48 is accepted and ignored by this firmware",
      "rule": "ignored-code",
      "severity": "warn",
    },
    {
      "line": 4,
      "message": "Q words are not supported by this firmware",
      "rule": "unsupported-word",
      "severity": "block",
    },
    {
