      "rule": "e-word",
      "severity": "block",
    },
    {
      "line": 6,
      "message": "M201.3 is not supported in a job on this firmware (a dotted code is never sent as M201)",
      "rule": "unsupported-code",
      "severity": "block",
    },
  ],
