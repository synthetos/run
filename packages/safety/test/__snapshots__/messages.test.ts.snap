    "citation": "SAFETY §3 CONNECTED_UNKNOWN; §4.1 Anything else row",
    "reason": "Position verification is only offered while the position is untrusted.",
    "remedy": "Nothing to do.",
  },
  "positionVerify phase 0": {
    "allowed": false,
    "citation": "SAFETY §3 CONNECTED_UNKNOWN; §4.1 Anything else row",
    "reason": "Position verification is only offered while the position is untrusted.",
    "remedy": "Nothing to do.",
  },
  "read BOOTLOADER_MODE": {
    "allowed": false,
    "citation": "SAFETY §4.1 Read row",
    "reason": "Reads need an open port and are never sent to the bootloader.",
    "remedy": "Connect, or leave bootloader mode.",
  },
  "read NOT_CONNECTED": {
    "allowed": false,
    "citation": "SAFETY §4.1 Read row",
    "reason": "Reads need an open port and are never sent to the bootloader.",
    "remedy": "Connect, or leave bootloader mode.",
  },
  "read phase 0": {
    "allowed": true,
  },
  "resetController BOOTLOADER_MODE": {
    "allowed": false,
    "citation": "SAFETY §4.1 Reset controller row; §3 ^X rule",
    "reason": "Reset controller is never sent to the bootloader and needs an open port.",
    "remedy": "Use the reset button on the board.",
  },
  "resetController NOT_CONNECTED": {
    "allowed": false,
    "citation": "SAFETY §4.1 Reset controller row; §3 ^X rule",
    "reason": "Reset controller is never sent to the bootloader and needs an open port.",
    "remedy": "Use the reset button on the board.",
  },
  "resetController phase 0": {
    "allowed": false,
    "citation": "ROADMAP P0-10 (Phase 0)",
    "reason": "Not available in this release.",
    "remedy": "This version of run.synthetos.com does not connect to machines yet.",
  },
  "resume BOOTLOADER_MODE": {
    "allowed": false,
    "citation": "SAFETY §4.1 Resume row",
    "reason": "Resume is only for a held or paused job started in this session.",
    "remedy": "Use Stop job to end the job.",
  },
  "resume NOT_CONNECTED": {
    "allowed": false,
    "citation": "SAFETY §4.1 Resume row",
    "reason": "Resume is only for a held or paused job started in this session.",
    "remedy": "Use Stop job to end the job.",
  },
  "resume phase 0": {
    "allowed": false,
    "citation": "ROADMAP P0-10 (Phase 0)",
    "reason": "Not available in this release.",
    "remedy": "This version of run.synthetos.com does not connect to machines yet.",
  },
  "setWorkZero BOOTLOADER_MODE": {
    "allowed": false,
    "citation": "SAFETY §4.1 Set work zero row",
    "reason": "Only allowed while the machine is idle.",
    "remedy": "Wait until the machine is idle.",
  },
  "setWorkZero NOT_CONNECTED": {
    "allowed": false,
    "citation": "SAFETY §4.1 Set work zero row",
    "reason": "Only allowed while the machine is idle.",
    "remedy": "Wait until the machine is idle.",
  },
  "setWorkZero phase 0": {
    "allowed": false,
    "citation": "ROADMAP P0-10 (Phase 0)",
    "reason": "Not available in this release.",
    "remedy": "This version of run.synthetos.com does not connect to machines yet.",
  },
  "settingsWrite BOOTLOADER_MODE": {
    "allowed": false,
