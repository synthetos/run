// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`W and C strings > render exactly as pinned 1`] = `
{
  "c10": "Soft limits are inactive on X, Y. Type RUN UNHOMED to continue.",
  "c12": "This machine is set to pause the job when this tab is hidden. Keep the job running in the background for this session instead? If the tab is hidden, the job continues and the spindle stays on. Type BACKGROUND.",
  "c13": "Clear the alarm? limit switch hit. Position may be wrong; homing will be required.",
  "c13En207": "Clear the alarm? The job was stopped. Position is kept; homing is recommended.",
  "c14": "This file has 2 tool changes (M6). The controller does not stop for M6. Insert "M5 M9 M0" before each M6? The sender will stop sending at each one and wait until the machine has stopped before asking you to change the tool.",
  "c15en": "Reset controller 0084-1234 now? Holding torque drops and position is lost.",
  "c15tg": "Reset controller 0084-1234 now? Holding torque drops and position is lost. If the controller is stalled this may not work; press the reset button on the board.",
  "c16": "Set X, Y and Z zero at the tool's current position? The board saves it (as G54), so it stays until you set zero again.",
  "c17": "The last session ended before restoring xtn. Restore the original values now? xtn -5 → 0",
  "c18": "The board is running factory defaults (spep 1), which may not match your machine. Homing and jogging stay blocked until you restore. Type LEAVE WITHOUT RESTORE to continue.",
  "c19": "Apply profile Router revision 5 to Shapeoko (0084-1234)? xvm 8000 → 10000. High-risk changes: none.",
  "c1Full": "Before connecting, confirm: ☐ A hardwired E-stop that removes motor and spindle power is installed and I tested it today. ☐ Limit switches or soft limits are configured, or I will keep moves small. ☐ The work area is clear of people, tools and loose items. ☐ I am wearing eye and ear protection. ☐ I will not leave the machine unattended while it is powered.",
  "c1Short": "☐ My E-stop is within reach and I tested it today.",
  "c20Changed": "This file changed since you last ran 'pocket.nc' on Shapeoko (yesterday, from laptop). 3 lines changed. Review the changes before arming.",
  "c20New": "This file has never been run on Shapeoko from this browser. Review the preflight report below before arming.",
  "c21": "The screen may sleep or lock during this job, which can freeze or hide this tab. Type NO WAKE LOCK to start anyway.",
  "c22": "This file ends with the spindle on, S12000 and coolant on and no program end that turns them off. Append "M5 M9" so the job ends with them off?",
  "c23": "Keep the settings on Shapeoko (0084-1234) and save them as profile revision 6? Nothing is written to the controller.",
  "c24": "Spindle will start (CW, S12000). Hands clear?",
  "c25": "Go to work zero on X and Y? The machine will move: Z up to machine -1 mm, then X and Y to 0. Keep a hand on the E-stop.",
  "c26": "Set the machine's position to 0 here, without moving? Use this only on a machine without homing switches, with each axis where you want machine zero. If this spot is wrong, the travel limits and every move after it are wrong too.",
  "c27": "Set a temporary offset so that X and Y read 0 here (G92)? It is not saved on the controller: a reset or a program end clears it, and Clear temporary offset (G92.1) removes it. The saved G54 offset does not change.",
  "c28": "Clear the temporary offset (G92.1)? Work positions go back to the saved G54 offsets.",
  "c29": "Use G55 for work coordinates? Work positions, Set work zero and Go to zero then use its saved offsets.",
  "c3": "Axis X will move +0.25 mm at 300 mm/min (expected 200 motor steps). Hand on E-stop?",
  "c30": "Start part.nc? Work zero: G54. Spindle: not used. Keep a hand on the E-stop.",
  "c31": "The board's work zero (X 0) is not your plan's (X 1). The job cuts where the board's work zero is. Use the board's work zero for this job?",
  "c32": "This job starts the spindle (S12000). It starts when that line runs, without another question. Hands clear of the cutter?",
  "c33": "Skip line 4 (G1 X300) and continue? The controller refused it, so it did not run. The job continues with the next line, which may not be what the file meant.",
  "c34": "Resume with T2? Run sends the tool change line 7, returns to where the job stopped at a safe height if you moved the machine, and continues the job.",
  "c35": "The spindle was on before the tool change and the file does not start it again. Run starts it (M3 S12000) before the job continues. Hands clear?",
  "c36": "The machine is not homed, so soft limits may not protect it. Start only if you have checked where every axis is and that the job fits. I've checked the machine.",
  "c3negative": "Axis X will move -0.25 mm at 300 mm/min (expected 200 motor steps). Hand on E-stop?",
  "c3zero": "Axis X will move 0 mm at 300 mm/min (expected 0 motor steps). Hand on E-stop?",
  "c4": "Home X, Y and Z? The machine will move each axis toward its homing switch until it triggers (the controller homes Z first). The search can travel up to 310 mm (|tm − tn| + lb from the controller's settings). Hand on E-stop?",
  "c40": "Run cannot check this job against the machine's travel: line 2: X would reach machine 200 mm, beyond its travel limit of 150 mm. Start only if you have checked that every move fits the machine.",
  "c40Body": "The travel limits of Z were not read. Start only if every move fits.",
  "c40Title": "Run can't check this job against the travel.",
  "c41": "X isn't homed, so Run can't check its travel and soft limits may not protect it. Line 2: X would reach 200 mm, past its 150 mm limit. I've checked where every axis is and that every move fits.",
  "c41Body": "Line 2 moves X to 200 mm. X stops at 150 mm. X isn't homed, so its position may be off. Other lines go past too.",
  "c41More": "Z isn't homed, so Run can't check its travel and soft limits may not protect it. Line 40: Z would reach -80.25 mm, past its -75 mm limit, and 2 more. I've checked where every axis is and that every move fits.",
  "c41Title": "This job goes past the X limit.",
  "c41ZeroFirst": "Your work zero isn't where you planned it.",
  "c4TemporaryCap": "Home Z, then X, then Y. Each axis moves toward its switch until it triggers (search limited to 40 mm). To limit the search, travel (0/300) is changed temporarily and restored after homing. Hand on E-stop?",
  "c5": "Write 3 settings to Shapeoko (0084-1234)? Changes: xvm 8000 → 10000. High-risk changes: xvm, yvm.",
  "c5none": "Write 1 settings to Shapeoko (0084-1234)? Changes: xjm. High-risk changes: none.",
  "c6Boxes": "☐ 1. Motor power is OFF. ☐ 2. Motors are unplugged from the board (only with power off). ☐ 3. Any axis that can fall (Z) is lowered or supported. ☐ 4. Spindle, VFD, laser and coolant mains power are switched off and isolated. ☐ 5. The tool is clear of the work, and the E-stop is within reach. ☐ 6. Motor power is back ON (TinyG's logic is powered from it). ☐ 7. I have downloaded the settings backup. ☐ Spindle and VFD mains are switched off and will stay off until my settings are restored and confirmed",
  "c6Question": "Flash TinyG 0084-1234 from build 440.21 to 450.01 (sha256 ab12cd34)?",
  "c7": "Arm job pocket.nc (sha256 ab12cd34, SAME): 1200 lines, units mm, WCS G54 (read from machine), X -1.5..20, Y -1.5..20, Z min -3, spindle ON S12000, estimated 12 min, may continue up to 38 mm (about 4 s, estimate) if the connection is lost; no single line queues more than 4.9 s (2 long moves were split). Wake lock ON. ☐ E-stop in reach, work clamped, area clear, screen lock off.",
  "c7off": "Arm job pocket.nc (sha256 ab12cd34, NEW): 1 lines, units inch, WCS G55 (read from machine), X -1.5..20, Y -1.5..20, Z min 0, spindle OFF, estimated 1 s, may continue up to 1 mm (about 1 s, estimate) if the connection is lost; no single line queues more than 1 s (0 long moves were split). Wake lock OFF. ☐ E-stop in reach, work clamped, area clear, screen lock off.",
  "c8": "Start pocket.nc now?",
  "c9": "Resume held job (paused at line 120)? Spindle: on, S12000. Offsets unchanged since hold.",
  "c9SpindleRestart": "Restart spindle M3 at S12000 and wait 3 s before motion?",
  "noBaseline": "No baseline on this computer",
  "provenance": {
    "elsewhere": "made elsewhere",
    "thisComputer": "made on this computer",
  },
  "startTick": "I confirm: the board's work zero · axes checked · hands clear · I'll stay here, sleep off.",
  "typed": {
    "background": "BACKGROUND",
    "leaveWithoutRestore": "LEAVE WITHOUT RESTORE",
    "noWakeLock": "NO WAKE LOCK",
    "runUnhomed": "RUN UNHOMED",
    "write": "WRITE",
  },
  "w1": "WARNING — This software is not an emergency stop. Your machine must have a hardwired E-stop that removes motor and spindle power. Keep it within reach whenever the machine is powered.",
  "w10": "On TinyG a feedhold does not stop the spindle or coolant. Use "Stop job" to end the job with the spindle off.",
  "w11": "DANGER — Flashing resets the controller. Motors lose holding torque and outputs may switch on or toggle. Do not unplug the board or close this tab until flashing finishes. An interruption in the last seconds can leave the board needing a programmer.",
  "w12": "DANGER — STOP NOT CONFIRMED. The machine did not report that it stopped. USE YOUR E-STOP.",
  "w13": "NOTICE — This preview uses our interpreter, not your firmware. It can miss problems. Configure homing and firmware soft limits ($sl=1).",
  "w14Footer": "This diagram does not replace a qualified electrician. Emergency stop circuits must remove motor and spindle power in hardware.",
  "w14Watermark": "INCOMPLETE — NO E-STOP SHOWN",
  "w15en": "Laser and plasma control on TinyG is not supported by this tool. A feedhold leaves the output on, so a laser would keep firing.",
  "w15tg": "Laser and plasma control on TinyG is not supported by this tool. This firmware has no output polarity setting and a feedhold leaves the output on.",
  "w16": "The reset button on the board is not an E-stop. A reset makes outputs float and may switch an active-low relay ON.",
  "w17": "WARNING — Program paused. The spindle and coolant may still be running (UNCONFIRMED): this firmware does not turn them off at a program stop. Wait for the spindle to stop, or use your E-stop, before reaching in.",
  "w18": "WARNING — Resetting the controller drops motor holding torque, so axes that can fall (Z) may drop. Outputs float during the reset. Machine position will be lost and homing will be required.",
  "w19": "NOTICE — These reporting settings are stored on the board. Other programs (CNCjs, ChiliPeppr, serial-port-json-server, your own scripts) read them too, and may stop working correctly if they change. This tool restores the original values when you disconnect normally. If this tab crashes, reconnect here and choose "Restore original reporting settings" before using another program.",
  "w20": "WARNING — Direction and distance are not verified. Before running anything, check with small moves (1 mm or less), hand on the E-stop, that each axis moves the right way and the right distance.",
  "w21": "Switch motor power OFF before connecting or disconnecting motors.",
  "w22": "Signed out. A running job and Pause, Stop and Spindle off are not affected. Sign in again to start a job, jog, home, or change settings. Cloud save is paused until you sign in again.",
  "w23": "WARNING — The saved profile for Shapeoko changed since this browser last applied it (revision 3 → 4, changed from laptop on 2026-11-01). Nothing has been written to the controller. Review the differences before applying.",
  "w24file": "WARNING — This file was changed from a sign-in this browser has not seen before (laptop, 2026-11-01). If you did not make this change, do not use it, and sign out everywhere from your account page.",
  "w24profile": "WARNING — This profile was changed from a sign-in this browser has not seen before (laptop, 2026-11-01). If you did not make this change, do not use it, and sign out everywhere from your account page.",
  "w25sender": "This controller's firmware (449.01, stock build) is supported read-only. You can view settings and send a feedhold, but not move the machine. Use your usual sender.",
  "w25upgrade": "This controller's firmware (449.01, stock build) is supported read-only. You can view settings and send a feedhold, but not move the machine. Upgrade to the approved TinyG firmware.",
  "w26": "The controller ignores feedhold while it is dwelling or waiting for the spindle. Use "Stop job" to stop now, or your E-stop.",
  "w27": "Job stopped. The controller turned the spindle and coolant off and is in alarm 207. Check the machine, then clear the alarm to continue.",
  "w28": "DANGER — Keep spindle and VFD mains switched off. While flashing, while the board is in the bootloader and until your settings are restored, the controller's outputs float or use factory polarity, which can switch an active-low spindle relay or VFD ON.",
  "w29": "NO TAB CONTROLS THIS MACHINE — the controlling tab closed or crashed. The machine may still be moving and the spindle may still be running. Use your E-stop.",
  "w2Label": "Pause",
  "w2Tooltip": "Decelerates and pauses motion. The spindle and coolant keep running. Use "Stop job" to stop with the spindle off, and your E-stop in an emergency.",
  "w3": "DANGER — Connection lost. The machine may still be moving and the spindle may still be running. Use your E-stop if anything is unsafe. Machine position is now unknown.",
  "w30": "PAUSED — SPINDLE MAY BE RUNNING",
  "w31": "This job will be stopped with the spindle off in 20 s, because it is paused with the spindle on. Choose "Keep paused" to wait longer.",
  "w32": "WARNING — This controller is paused, holding or still has queued moves from a previous session. This page did not send them and cannot resume them. Use "Stop job" to end them with the spindle off, or reset the controller.",
  "w33": "DANGER — This page lost track of the machine (tab frozen). The machine is paused and the spindle may be running. The job will be stopped with the spindle off in 20 s. Check the machine now.",
  "w34": "WARNING — The machine is not homed, so soft limits may not protect it. A jog can drive an axis into its end. Use small steps and keep a hand on the E-stop.",
  "w35": "NOTICE — Run set this board's status reports to include position, spindle, coolant and tool. The list is saved on the board, so other programs that read its status reports see the change too.",
  "w36": "NOTICE — Run changed a reporting setting saved on this board: sv from 0 to 1. Other programs that read its status reports see the change too.",
  "w37": "WARNING — Tool change. The job is stopped and Run turned the spindle and coolant off. Wait until the spindle has stopped turning before you reach in, and keep a hand on the E-stop while you jog.",
  "w38": "WARNING — The controller refused line 12 (status 221: outside the soft limits). The job is paused and nothing after that line is sent. Lines sent before it may still run. Use "Stop job", or skip the line and continue.",
  "w39": "NOTICE — Run changed a board setting for this job: it sends the job one line at a time (saved on the board). Run puts the setting back when the job ends; if this page closes during the job, the next connect from this browser puts it back. Programs that count characters need the old setting.",
  "w4": "WARNING — No status from the machine for 2 s. Commands are blocked. What you see may be out of date.",
  "w40": "DANGER — The controller reset during the job at line 40. Everything queued is gone and the machine position is unknown. Outputs may have switched during the reset. Check the machine before doing anything.",
  "w41": "Line 40 is already queued on the controller, so a breakpoint there cannot stop the job.",
  "w42": "Stopped at line 40: queue cleared, spindle and coolant off",
  "w43": "Stopped at breakpoint · line 40",
  "w44": "NOTICE — Run had switched this board to line mode (rxm 1) for a job that did not end here. Run put it back to rxm 0 (saved on the board).",
  "w5": "WARNING — If this tab closes or sleeps, the machine keeps moving (up to 38 mm, about 4 s) and the spindle stays on, a fire risk. Keep this tab open and stay at the machine.",
  "w5Hb": "WARNING — If this tab stops responding, the controller is set to stop motion and turn the spindle off within about 3 s. This is not an E-stop and can fail. Keep this tab visible and stay at the machine.",
  "w6": "WARNING — The previous session ended while connected to a live machine. The machine may have kept moving after this page stopped. Check the machine before doing anything. Machine state is UNKNOWN until you reconnect and re-home.",
  "w6Question": "Has the machine moved since last time?",
  "w6QuestionBody": "The last session ended while connected, so Run can't trust the position.",
  "w6Strip": "Position not verified: the last session ended while connected.",
  "w6Verify": "It hasn't moved",
  "w7": "NOT CONNECTED — no machine. Preview and setup only; nothing on this page is moving a machine.",
  "w8": "LIVE — connected to Shapeoko (0084-1234, 450.01) on COM3. Commands move the real machine.",
  "w9": "Soft limits are inactive: axis Y is not homed. The machine can travel past its limits.",
}
`;

