{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Runtime source gets no DOM types. Node types are present for the
    // TextEncoder/TextDecoder the protocol sources use; dependency-cruiser's
    // safety-path-no-node-core refuses any Node built-in import.
    "types": ["node"]
  },
  "include": ["src"]
}
