{
  "name": "synthetos-run",
  "version": "0.0.0",
  "private": true,
  "description": "run.synthetos.com: browser workspace for configuring and running Synthetos CNC controllers.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": "10.34.6"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "deps": "depcruise packages apps workers tools --config .dependency-cruiser.cjs",
    "licence": "node tools/gates/src/licence/cli.ts",
    "gates": "pnpm lint && pnpm deps && pnpm licence && pnpm ci-policy",
    "test": "pnpm -r test",
    "build": "pnpm --filter web build",
    "build:fake-serial": "pnpm --filter @synthetos/web exec vite build --mode fake-serial",
    "check": "pnpm typecheck && pnpm gates && pnpm test && pnpm build && pnpm scan && pnpm build:fake-serial && pnpm fake-serial:diff",
    "ci-policy": "node tools/gates/src/workflow/cli.ts && node tools/gates/src/codeowners/cli.ts && node tools/gates/src/review/template-cli.ts",
    "scan": "node tools/gates/src/bundle/cli.ts apps/web/dist",
    "fake-serial:diff": "node tools/gates/src/artifact/diff-cli.ts apps/web/dist apps/web/dist-fake-serial",
    "repro": "node tools/gates/src/repro/local.ts",
    "gen:headers": "node tools/gates/src/headers/gen.ts",
    "e2e": "pnpm build && pnpm --filter @synthetos/e2e e2e",
    "e2e:artifact": "pnpm build && node tools/e2e/src/artifact-local.ts",
    "e2e:fake-serial": "pnpm build && pnpm build:fake-serial && pnpm fake-serial:diff && pnpm --filter @synthetos/e2e e2e:fake-serial",
    "gen:contrast": "node tools/gates/src/tokens/contrast-cli.ts",
    "gen:icons": "node tools/gates/src/icons/gen.ts",
    "tokens:drift": "node tools/gates/src/tokens/drift-cli.ts",
    "sign:builds": "node tools/gates/src/release/sign-cli.ts",
    "gen:schema": "node tools/gates/src/schema/gen.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.14.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
